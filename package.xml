<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/htmltopdf" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/htmltopdf" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="documents.html-to-pdf">
                <title>HTML-to-PDF generation</title>
                <description>
                    Generates styled PDF documents from HTML with configurable headers, footers and output options.
                </description>
            </capability>

            <capability id="media.pdf-to-image-conversion">
                <title>PDF-to-image conversion</title>
                <description>
                    Converts single-page and multi-page PDF documents into image files through a configurable provider.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/htmltopdf/bin/images/Logo.jpg"/>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/htmltopdf]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/htmltopdf/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/htmltopdf/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[PCSG QL-1.0]]></license>
            <license><![CDATA[CC BY-NC-SA 4.0]]></license>
        </copyright>

        <provider>
            <htmlToPdfCreator src="\QUI\HtmlToPdf\Provider\Pdf\Mpdf\Provider"/>
            <htmlToPdfCreator src="\QUI\HtmlToPdf\Provider\Pdf\ChromeHeadless\Provider"/>

            <pdfToImageConverter src="\QUI\HtmlToPdf\Provider\Image\ImageMagick\Provider"/>
        </provider>
    </package>
</quiqqer>
